// =====================================
// Edit Patient Data
// =====================================

void handleEdit()
{
    if (server.hasArg("id"))
    {
        int id =
            server.arg("id").toInt();

        if (id >= 0 &&
            id < TOTAL_PATIENTS)
        {
            // Change Name
            if (server.hasArg("name"))
            {
                String newName =
                    server.arg("name");

                if (newName.length() > 0)
                {
                    patientNames[id] =
                        newName;
                }
            }

            // Change Calibration
            if (server.hasArg("offset"))
            {
                String offsetValue =
                    server.arg("offset");

                if (offsetValue.length() > 0)
                {
                    calibrationOffset[id] =
                        offsetValue.toFloat();
                }
            }
        }
    }

    server.sendHeader("Location", "/");

    server.send(303);
}

// =====================================
// CSV Download
// =====================================

void handleCSV()
{
    server.sendHeader(
        "Content-Disposition",
        "attachment; filename=medical_logs.csv"
    );

    server.send(
        200,
        "text/csv",
        csvData
    );
}